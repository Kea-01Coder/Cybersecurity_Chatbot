<Window x:Class="Cybersecurity_ChatbotWPF.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz" 
        Height="550" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">

    <Window.Resources>
        <!-- Progress Bar Style -->
        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="BorderBrush" Value="#00D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Answer Button Style -->
        <Style x:Key="AnswerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F3460"/>
                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F3460" Padding="15">
            <StackPanel>
                <TextBlock Text="Cybersecurity Quiz" 
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="#E94560"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Test your cybersecurity knowledge!" 
                           FontSize="12" 
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Score and Progress -->
        <Border Grid.Row="1" Background="#16213E" Padding="15" Margin="15,10,15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Score: " Foreground="#888888" FontSize="14"/>
                    <TextBlock x:Name="ScoreText" Text="0" Foreground="#E94560" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <ProgressBar Grid.Column="1" 
                             x:Name="ProgressBar" 
                             Style="{StaticResource ProgressBarStyle}"
                             Margin="15,0,15,0"
                             Value="0" 
                             Minimum="0" 
                             Maximum="100"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="ProgressText" Text="0/0" Foreground="#00D4FF" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Question Area -->
        <Border Grid.Row="2" Background="#16213E" Padding="20" Margin="15,10,15,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Category Tag -->
                    <Border Background="#0F3460" 
                            Padding="10,5" 
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10">
                        <TextBlock x:Name="CategoryText" 
                                   Text="Category" 
                                   Foreground="#00D4FF" 
                                   FontSize="11"/>
                    </Border>

                    <!-- Question Text -->
                    <TextBlock x:Name="QuestionText" 
                               Text="Loading question..." 
                               FontSize="16" 
                               Foreground="#E0E0E0"
                               TextWrapping="Wrap"
                               Margin="0,5,0,20"/>

                    <!-- Answer Options -->
                    <ItemsControl x:Name="AnswerOptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Style="{StaticResource AnswerButtonStyle}" 
                                        Click="AnswerButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Feedback Area -->
        <Border Grid.Row="3" 
                x:Name="FeedbackBorder"
                Background="#0F3460" 
                Padding="15" 
                Margin="15,0,15,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FeedbackText" 
                           Text="Correct!" 
                           FontSize="14" 
                           Foreground="#4CAF50"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ExplanationText" 
                           Text="Explanation goes here..." 
                           FontSize="12" 
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
                <Button x:Name="NextButton" 
                        Content="Next Question →" 
                        Background="#E94560"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="15,8"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Click="NextButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Bottom Bar -->
        <StatusBar Grid.Row="4" Background="#0F3460" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" 
                           Foreground="#00D4FF" 
                           FontSize="11"
                           Text="Answer each question to test your knowledge!"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="CloseButton" 
                        Content="✕ Close Quiz" 
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>