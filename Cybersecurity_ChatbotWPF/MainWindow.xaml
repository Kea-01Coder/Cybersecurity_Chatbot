<Window x:Class="CybersecurityChatbotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuardian AI - Cybersecurity Awareness Bot" 
        Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="800">

    <Window.Resources>
        <Style x:Key="QuickTipButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="BorderBrush" Value="#00D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00D4FF"/>
                    <Setter Property="Foreground" Value="#1A1A2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <!-- Header Panel with ASCII Art -->
       
        <Border Grid.Row="0" Background="#0F3460" Padding="15,10,15,10">
            <StackPanel>
                <TextBlock FontFamily="Consolas" 
                   FontSize="10" 
                   Foreground="#00D4FF"
                   FontWeight="Normal"
                   LineHeight="10"
                   TextWrapping="NoWrap"
                   xml:space="preserve">
                    <TextBlock.Text>
                                                                                             ██████╗██╗   ██╗██████╗ ███████╗██████╗ 
                                                                                            ██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗
                                                                                            ██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝
                                                                                            ██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗
                                                                                            ╚██████╗   ██║   ██████╔╝███████╗██║  ██║
                                                                                             ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝
                    </TextBlock.Text>
                </TextBlock>

                <TextBlock Text="🛡️  CYBERSECURITY AWARENESS BOT  🛡️" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="#E94560"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>

                <TextBlock Text="Your personal guide to staying safe online" 
                   FontSize="10" 
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <!-- Chat Display Area -->
        <Border Grid.Row="1" Margin="15" Background="#16213E">
            <ListBox x:Name="ChatListBox" 
                     Background="Transparent"
                     BorderBrush="Transparent"
                     FontSize="14"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5,0,5" 
                                Background="#1A1A2E"
                                Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Sender}" 
                                               FontWeight="Bold"
                                               Foreground="{Binding SenderColor}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding Timestamp}" 
                                               Foreground="#666666"
                                               FontSize="10"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" 
                                           TextWrapping="Wrap"
                                           Foreground="#E0E0E0"
                                           Margin="0,5,0,0"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Quick Tips Bar -->
        <Border Grid.Row="2" 
                Background="#0F3460" 
                Padding="8"
                Margin="15,0,15,10">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Password Tips" Style="{StaticResource QuickTipButton}" Click="QuickTipPassword_Click"/>
                <Button Content="Phishing Tips" Style="{StaticResource QuickTipButton}" Click="QuickTipPhishing_Click"/>
                <Button Content="Scam Alerts" Style="{StaticResource QuickTipButton}" Click="QuickTipScam_Click"/>
                <Button Content="Privacy Guide" Style="{StaticResource QuickTipButton}" Click="QuickTipPrivacy_Click"/>
                <Button Content="Help" Style="{StaticResource QuickTipButton}" Click="QuickTipHelp_Click"/>
            </WrapPanel>
        </Border>

        <!-- Input Panel -->
        <Border Grid.Row="3" 
                Background="#0F3460" 
                Padding="10"
                Margin="15,0,15,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputTextBox" 
                         Grid.Column="0"
                         FontSize="14"
                         Padding="12,10,12,10"
                         Background="#1A1A2E"
                         Foreground="White"
                         BorderBrush="#E94560"
                         BorderThickness="1"
                         KeyDown="UserInputTextBox_KeyDown"/>

                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Content="📤 Send" 
                        Width="80"
                        Margin="10,0,0,0"
                        Background="#E94560"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="8"
                        Cursor="Hand"
                        Click="SendButton_Click"/>

                <Button x:Name="SpeakOutputButton" 
                        Grid.Column="3"
                        Content="🔊" 
                        Width="50"
                        Margin="5,0,0,0"
                        Background="#2E8B57"
                        Foreground="White"
                        FontSize="16"
                        Cursor="Hand"
                        Click="SpeakOutputButton_Click"
                        ToolTip="Read last response aloud"/>
            </Grid>
        </Border>

		<!-- Quick Tips Bar - Updated with Part 3 buttons -->
		<Border Grid.Row="2"
				Background="#0F3460"
				Padding="8"
				Margin="15,0,15,10"
				CornerRadius="8">
			<WrapPanel HorizontalAlignment="Center">
				<Button Content="Password" Style="{StaticResource QuickTipButton}" Click="QuickTipPassword_Click"/>
				<Button Content="Phishing" Style="{StaticResource QuickTipButton}" Click="QuickTipPhishing_Click"/>
				<Button Content="Scam" Style="{StaticResource QuickTipButton}" Click="QuickTipScam_Click"/>
				<Button Content="Privacy" Style="{StaticResource QuickTipButton}" Click="QuickTipPrivacy_Click"/>
				<Button Content="Tasks" Style="{StaticResource QuickTipButton}" Click="QuickTipTasks_Click"/>
				<Button Content="Quiz" Style="{StaticResource QuickTipButton}" Click="QuickTipQuiz_Click"/>
				<Button Content="Help" Style="{StaticResource QuickTipButton}" Click="QuickTipHelp_Click"/>
			</WrapPanel>
		</Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#0F3460" Height="30" Margin="0,61,0,-15">
            <StatusBarItem RenderTransformOrigin="0.499,1.183">
                <TextBlock x:Name="StatusText" 
                           Foreground="#00D4FF" 
                           Text="Ready to help you stay safe online!"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>