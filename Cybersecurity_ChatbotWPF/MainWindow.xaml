<Window x:Class="CybersecurityChatbotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ CyberGuardian AI - Cybersecurity Chatbot" 
        Height="650" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#0F3460" Padding="15" CornerRadius="0,0,10,10">
            <StackPanel>
                <TextBlock x:Name="AsciiArt" 
                           FontFamily="Consolas" 
                           FontSize="10" 
                           Foreground="#00D4FF"
                           TextAlignment="Center"
                           Text="██████╗██╗   ██╗██████╗ ███████╗██████╗ 
██╔════╝╚██╗ ██╔╝██╔══██╗██╔════╝██╔══██╗
██║      ╚████╔╝ ██████╔╝█████╗  ██████╔╝
██║       ╚██╔╝  ██╔══██╗██╔══╝  ██╔══██╗
╚██████╗   ██║   ██████╔╝███████╗██║  ██║
 ╚═════╝   ╚═╝   ╚═════╝ ╚══════╝╚═╝  ╚═╝"
                           FontWeight="Bold"/>
                <TextBlock Text="🛡️  CYBERSECURITY AWARENESS BOT  🛡️" 
                           FontSize="18" 
                           FontWeight="Bold"
                           Foreground="#E94560"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat Display Area - SIMPLIFIED VERSION (NO COMPLEX TEMPLATES) -->
        <ListBox x:Name="ChatListBox" 
                 Grid.Row="1" 
                 Margin="15"
                 Background="#16213E"
                 BorderBrush="#0F3460"
                 BorderThickness="2"
                 FontSize="14"
                 Foreground="White">
        </ListBox>

        <!-- Input Panel -->
        <Border Grid.Row="2" 
                Background="#0F3460" 
                Padding="10" 
                CornerRadius="10"
                Margin="15,0,15,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputTextBox" 
                         Grid.Column="0"
                         FontSize="14"
                         Padding="10"
                         Background="#1A1A2E"
                         Foreground="White"
                         BorderBrush="#E94560"
                         BorderThickness="1"
                         KeyDown="UserInputTextBox_KeyDown"/>

                <Button x:Name="SendButton" 
                        Grid.Column="1"
                        Content="Send" 
                        Width="80"
                        Margin="10,0,0,0"
                        Background="#E94560"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="8"
                        Click="SendButton_Click"/>

                <Button x:Name="VoiceInputButton" 
                        Grid.Column="2"
                        Content="🎤" 
                        Width="50"
                        Margin="5,0,0,0"
                        Background="#533483"
                        Foreground="White"
                        FontSize="16"
                        Click="VoiceInputButton_Click"/>

                <Button x:Name="SpeakOutputButton" 
                        Grid.Column="3"
                        Content="🔊" 
                        Width="50"
                        Margin="5,0,0,0"
                        Background="#2E8B57"
                        Foreground="White"
                        FontSize="16"
                        Click="SpeakOutputButton_Click"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#0F3460" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" 
                           Foreground="#00D4FF" 
                           Text="Ready to help you stay safe online!"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
